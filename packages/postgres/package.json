{
  "name": "@opentf/esrun-postgres",
  "version": "0.0.1",
  "description": "PostgreSQL driver for ES Runtime (esrun) — a runtime:db backend written entirely in JavaScript over runtime:net.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": {
    "esrun": ">=0.22.0"
  },
  "scripts": {
    "build": "bun run build.mjs",
    "test": "./test/unit/run.sh && ./test/run.sh",
    "test:unit": "./test/unit/run.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opentf/esrun-types": "file:../types",
    "typescript": "^7.0.2"
  },
  "keywords": ["esrun", "es-runtime", "opentf", "postgres", "postgresql", "database", "driver"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Tech-Foundation/ES-Runtime.git",
    "directory": "packages/postgres"
  },
  "homepage": "https://esrun.opentechf.org/docs/db",
  "publishConfig": {
    "access": "public"
  }
}
