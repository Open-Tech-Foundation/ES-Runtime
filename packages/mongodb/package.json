{
  "name": "@opentf/esrun-mongodb",
  "version": "0.1.0",
  "description": "MongoDB driver for esrun: the runtime's built-in driver, with its TypeScript types and BSON classes.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": {
    "esrun": ">=0.44.0"
  },
  "scripts": {
    "build": "esdev build --lib src"
  },
  "devDependencies": {
    "@opentf/esrun-types": "workspace:*",
    "typescript": "^7.0.2"
  },
  "keywords": ["esrun", "es-runtime", "opentf", "mongodb", "mongo", "bson", "database", "driver"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Tech-Foundation/ES-Runtime.git",
    "directory": "packages/mongodb"
  },
  "homepage": "https://esrun.opentechf.org/docs/db/mongodb",
  "publishConfig": {
    "access": "public"
  }
}
