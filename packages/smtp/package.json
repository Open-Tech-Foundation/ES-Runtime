{
  "name": "@opentf/esrun-smtp",
  "version": "0.1.0",
  "description": "SMTP client for esrun: STARTTLS and implicit TLS, PLAIN/LOGIN/XOAUTH2, MIME messages, pooling.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": {
    "esrun": ">=0.22.0"
  },
  "scripts": {
    "build": "esdev build --lib src"
  },
  "devDependencies": {
    "@opentf/esrun-types": "workspace:*",
    "typescript": "^7.0.2"
  },
  "keywords": ["esrun", "es-runtime", "opentf", "smtp", "email", "mail", "mime"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Tech-Foundation/ES-Runtime.git",
    "directory": "packages/smtp"
  },
  "homepage": "https://esrun.opentechf.org/docs/guides/email",
  "publishConfig": {
    "access": "public"
  }
}
