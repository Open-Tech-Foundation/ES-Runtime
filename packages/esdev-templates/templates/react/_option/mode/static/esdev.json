{
  "$schema": "https://esrun.opentechf.org/esdev.schema.json",
  "plugins": [
    "@opentf/esdev-plugin-react"
  ],
  "jsx": {
    "importSource": "react",
    "reactCompiler": true
  },
  "build": {
    "targets": {
      "web": {
        "entry": "index.html",
        "outDir": "dist"
      },
      "prerender": {
        "entry": "src/prerender.tsx",
        "out": "dist/prerender.js",
        "then": "run"
      }
    }
  },
  "dev": {
    "servers": {
      "web": {
        "port": 5173
      }
    }
  }
}
