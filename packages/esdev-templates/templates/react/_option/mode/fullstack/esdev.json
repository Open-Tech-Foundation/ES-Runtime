{
  "plugins": [
    "@opentf/esdev-plugin-react"
  ],
  "jsx": {
    "importSource": "react",
    "reactCompiler": true
  },
  "build": {
    "targets": {
      "server": {
        "entry": "src/server.tsx",
        "out": "dist/server.js"
      },
      "web": {
        "entry": "index.html",
        "outDir": "dist"
      }
    }
  },
  "dev": {
    "servers": {
      "server": {
        "port": 3000
      }
    }
  }
}
