{
  "name": "@opentf/esrun-mqtt",
  "version": "0.1.0",
  "description": "MQTT client for esrun: MQTT 5.0 with 3.1.1 fallback, publish/subscribe at QoS 0/1/2, sessions, TLS.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": {
    "esrun": ">=0.41.0"
  },
  "scripts": {
    "build": "esdev build --lib src"
  },
  "devDependencies": {
    "@opentf/esrun-types": "workspace:*",
    "typescript": "^7.0.2"
  },
  "keywords": ["esrun", "es-runtime", "opentf", "mqtt", "iot", "messaging", "pubsub", "broker"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Tech-Foundation/ES-Runtime.git",
    "directory": "packages/mqtt"
  },
  "homepage": "https://esrun.opentechf.org/docs/guides/mqtt",
  "publishConfig": {
    "access": "public"
  }
}
