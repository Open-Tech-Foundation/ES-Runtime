{
  "plugins": [
    {
      "module": "@opentf/esdev-plugin-afw",
      "options": {
        "appDir": "app"
      }
    },
    {
      "module": "@opentf/afw-docs/build",
      "export": "docsNavPlugin",
      "options": {
        "appDir": "app"
      }
    },
    {
      "module": "@opentf/afw-docs/build",
      "export": "lastUpdatedPlugin",
      "options": {
        "appDir": "app"
      }
    },
    {
      "module": "@opentf/afw-docs/build",
      "export": "codeHighlightPlugin"
    },
    {
      "module": "@opentf/afw-cli/ssg",
      "export": "siteOutputPlugin",
      "options": {
        "root": ".",
        "target": "web",
        "prerenderTarget": "site-ssg"
      }
    }
  ],
  "build": {
    "targets": {
      "web": {
        "entry": "index.html",
        "outDir": "dist",
        "assets": [
          "public"
        ]
      },
      "site-ssg": {
        "entry": "ssg.js",
        "out": ".ssg/ssg.js",
        "then": "run"
      }
    }
  },
  "dev": {
    "servers": {
      "web": {
        "port": 5173
      }
    }
  }
}
