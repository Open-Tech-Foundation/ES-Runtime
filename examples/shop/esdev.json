{
  "targets": {
    "web": {
      "entry": "index.html",
      "outdir": "dist/public"
    },
    "server": {
      "entry": "src/server/main.js",
      "out": "dist/server.js"
    },
    "workers": {
      "entry": "src/server/workers.js",
      "out": "dist/workers.js"
    }
  },
  "start": {
    "run": "server"
  },
  "permissions": {
    "allow": {
      "read": true,
      "write": true,
      "listen": ["8080"],
      "net": true,
      "env": ["PORT", "SHARDS", "FAIL_RATE"],
      "signals": true,
      "workers": true,
      "imports": true
    }
  }
}
