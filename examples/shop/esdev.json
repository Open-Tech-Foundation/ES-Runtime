{
  "targets": {
    "web": {
      "entry": "index.html",
      "outdir": "dist/public"
    },
    "server": {
      "entry": "src/server/main.js",
      "out": "dist/server.js"
    }
  },
  "start": {
    "run": "server"
  },
  "permissions": {
    "allow": {
      "read": true,
      "write": true,
      "listen": [
        "8080"
      ],
      "net": true,
      "env": [
        "PORT",
        "SHARDS",
        "FAIL_RATE",
        "ADMIN_TOKEN"
      ],
      "signals": true,
      "workers": true,
      "imports": true
    }
  }
}
