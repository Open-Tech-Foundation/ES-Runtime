{
  "build": {
    "targets": {
      "web": {
        "entry": "index.html",
        "outdir": "dist/public"
      },
      "server": {
        "entry": "src/server/main.js",
        "out": "dist/server.js"
      }
    }
  },
  "dev": {
    "run": "server",
    "app": {
      "port": 8080
    }
  }
}
