{
  "name": "{{name}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "esdev start",
    "build": "esdev build --minify",
    "start": "esrun --allow-imports --allow-listen=8080 --allow-env=PORT dist/server.js",
    "test": "esdev test",
    "typecheck": "esdev typecheck"
  },
  "dependencies": {
    "elysia": "{{registry:elysia}}"
  },
  "devDependencies": {
    "@opentf/esrun-types": "{{registry:@opentf/esrun-types}}",
    "typescript": "{{registry:typescript}}"
  }
}
