{
  "name": "{{name}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "esdev start",
    "build": "esdev build --minify",
    "build:debug": "esdev build",
    "start": "esrun --allow-listen=8080 --allow-env=PORT --allow-signals=SIGTERM,SIGINT dist/server.js",
    "test": "esdev test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opentf/esrun-types": "latest",
    "typescript": "^5.9.0"
  }
}
