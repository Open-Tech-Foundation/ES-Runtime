{
  "plugins": [
    "./plugins/react-refresh.mjs"
  ],
  "jsx": {
    "importSource": "react",
    "reactCompiler": true
  },
  "build": {
    "targets": {
      "web": {
        "entry": "index.html",
        "outdir": "dist"
      },
      "prerender": {
        "entry": "src/prerender.tsx",
        "out": "dist/prerender.js",
        "then": "run"
      }
    }
  },
  "dev": {
    "watch": {
      "targets": [
        "web"
      ]
    }
  }
}
