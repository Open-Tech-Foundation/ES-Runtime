{
  "targets": {
    "web": {
      "entry": "index.html",
      "outdir": "dist",
      "refresh": "react",
      "plugins": ["./plugins/react-refresh.mjs"]
    },
    "prerender": {
      "entry": "src/prerender.tsx",
      "out": "dist/prerender.js",
      "then": "run"
    }
  },
  "start": {
    "watch": ["web"]
  }
}
