{
  "plugins": [
    "./plugins/react-refresh.mjs"
  ],
  "jsx": {
    "importSource": "react",
    "reactCompiler": true
  },
  "build": {
    "targets": {
      "server": {
        "entry": "src/server.tsx",
        "out": "dist/server.js"
      },
      "web": {
        "entry": "index.html",
        "outdir": "dist"
      }
    }
  },
  "dev": {
    "run": "server",
    "watch": {
      "targets": [
        "server",
        "web"
      ]
    },
    "app": {
      "port": 8080
    }
  }
}
