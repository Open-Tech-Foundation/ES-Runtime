{
  "targets": {
    "server": {
      "entry": "src/server.tsx",
      "out": "dist/server.js"
    },
    "web": {
      "entry": "index.html",
      "outdir": "dist"
    }
  },
  "start": {
    "run": "server",
    "watch": ["server", "web"]
  },
  "permissions": {
    "allow": {
      "read": ["./dist"],
      "env": ["PORT"],
      "listen": ["8080"],
      "signals": ["SIGTERM", "SIGINT"]
    }
  }
}
